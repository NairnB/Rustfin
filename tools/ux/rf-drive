#!/usr/bin/env bash
# rf-drive: drive the real app one step at a time (a naive tester sees a screenshot after each step).
#   rf-drive start --mode desk|tv --session NAME [--user U --pass P] [--server URL]
#   rf-drive NAME <command…>      one step; prints "step N: ok|error … — screenshot: PATH"
#   rf-drive stop NAME
# Commands (desk; x y are pixels in the 1280-wide screenshot you were shown): click x y · move x y · scroll dx dy (dy<0 = down, dx<0 = a row goes right) · drag x1 y1 x2 y2 ms · key <name> [n] · type <text> · wait <ms>
# TV: key Up/Down/Left/Right/Enter/Back/Info/PlayPause and wait only (the app enforces it).
# Session folder $RF_FLEET_HOME/NAME: in (FIFO) · out (one line per step) · cmds (the command of each step) · shots/NNN.jpg · data/ · run.sh · launch.log
# At most 8 sessions at once: each holds $RF_LOCKS/drive1..8 for as long as its container lives.
set -euo pipefail
# Optional private settings (RF_FLEET_HOME, RF_LOCKS, RF_RUNNER, ...): KEY=VALUE lines; variables already set win.
rf_env=${RF_ENV:-$HOME/.config/rf-fleet.env}
if [ -f "$rf_env" ]; then
  while IFS='=' read -r k v; do case $k in RF_*) [ -n "${!k+x}" ] || export "$k=$v";; esac; done < "$rf_env"
fi
FLEET=${RF_FLEET_HOME:-$HOME/rf-fleet}
LOCKS=${RF_LOCKS:-$FLEET/locks}
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
BIN=${RFD_BIN:-$ROOT/target/release/rustfin}
RUNNER=${RF_RUNNER:-}   # command that runs a command inside the build container: $RF_RUNNER -n NAME -- CMD
die() { echo "rf-drive: $*" >&2; exit 1; }

lines() { wc -l < "$1/out" 2>/dev/null || echo 0; }

# send <dir> <line> <timeout-s>: write the line to the FIFO, wait for its out line, print it.
send() {
  local d=$1 line=$2 t=${3:-30} before; before=$(lines "$d")
  [ -p "$d/in" ] || die "no such session"
  timeout "$t" bash -c 'printf "%s\n" "$1" > "$2"' _ "$line" "$d/in" || die "app did not take the command (is the session running?)"
  local end=$((SECONDS + t))
  while [ "$(lines "$d")" -le "$before" ]; do
    [ $SECONDS -lt $end ] || die "no answer within ${t}s"
    sleep 0.1
  done
  sed -n "$((before + 1))p" "$d/out"
}

step() {
  local d=$FLEET/$1; shift
  [ -d "$d" ] || die "no session $1"
  case "$*" in '!'*|*$'\n'*) die "unknown command";; esac   # '!' lines are the wrapper's own; one line per step
  local r n res; r=$(send "$d" "$*" 30)
  printf '%s\n' "$*" >> "$d/cmds"   # what was sent, one line per step (fleet-run counts presses from it)
  n=${r%% *}; res=${r#* }
  # The tester sees ok / the error, not the app's internal screen name.
  case "$res" in ok*) res=ok;; esac
  echo "step $((10#$n)): $res — screenshot: $d/shots/$n.jpg"
}

start() {
  local mode="" name="" user="" pass="" server=http://jf-real:8096
  while [ $# -gt 0 ]; do case "$1" in
    --mode) mode=$2; shift 2;; --session) name=$2; shift 2;; --user) user=$2; shift 2;;
    --pass) pass=$2; shift 2;; --server) server=$2; shift 2;; *) die "unknown option $1";; esac; done
  [[ $name =~ ^[A-Za-z0-9_-]+$ ]] || die "--session needs letters, digits, - or _"
  case "$name" in start|stop) die "session name taken by a command";; esac
  local size tvflag=""
  case "$mode" in desk) size=1440x900;; tv) size=1920x1080; tvflag=--tv;; *) die "--mode desk|tv";; esac
  [ -n "$RUNNER" ] || die "RF_RUNNER is not set (the command that runs a command inside the build container; see BUILDING.md, rf-drive)"
  [ -x "$BIN" ] || die "no app binary at $BIN (cargo build --release -p jf-desktop)"
  local d=$FLEET/$name
  [ ! -e "$d" ] || die "session $name exists (stop it and pick a new name)"
  mkdir -p "$LOCKS" "$d/shots" "$d/data"; mkfifo "$d/in"; : > "$d/out"; echo "$mode" > "$d/mode"
  # Xvfb directly (xvfb-run hangs when started detached); the container is its own X display :99.
  cat > "$d/run.sh" <<RUN
#!/usr/bin/env bash
Xvfb :99 -screen 0 ${size}x24 -nolisten tcp 2> "$d/xvfb.log" &
for _ in \$(seq 100); do [ -S /tmp/.X11-unix/X99 ] && break; sleep 0.1; done
DISPLAY=:99 exec "$BIN" --data-dir "$d/data" --size ${size%x*}x${size#*x} $tvflag --server "$server" --drive "$d" 2> "$d/app.log"
RUN
  chmod +x "$d/run.sh"
  cat > "$d/launch.sh" <<LAUNCH
#!/usr/bin/env bash
# Take a free slot (fd 9 stays locked while the container below runs), then run the app in its build container.
cd "$d"
for ((;;)); do
  for i in 1 2 3 4 5 6 7 8; do exec 9>$LOCKS/drive\$i; flock -n 9 && break 2; done
  sleep 2
done
echo \$i > "$d/slot"
exec "$RUNNER" -n rfd-$name -- "$d/run.sh"
LAUNCH
  if [ "$mode" = tv ] && [ -n "$user" ]; then   # signed in before the app starts: see the prelude below
    python3 -I "$ROOT/tools/ux/jfapi.py" presign "$d/data" "$server" "$user" "$pass" || { rm -rf "$d"; die "could not sign in $user"; }
  fi
  setsid nohup bash "$d/launch.sh" > "$d/launch.log" 2>&1 < /dev/null &
  while [ ! -f "$d/slot" ]; do sleep 1; done   # waits here while all 8 slots are busy
  if [ -n "$user" ]; then
    # Prelude: connect (the field comes pre-filled from --server: clear it, type it), sign in; its shots are dropped. The first line waits for the window to come up.
    local l r
    pre() { r=$(send "$d" "$1" "${2:-90}") || { stop_quiet "$name"; die "sign-in prelude failed (see $d/app.log)"; }; }
    until_screen() {   # poll with short waits until the app is on screen $1 (the tours' wait-screen), up to ~20 s
      local i; for i in $(seq 40); do case "$r" in *" $1 "*) return;; esac; pre "wait 500" 30; done
      stop_quiet "$name"; die "sign-in stuck before $1: $r"
    }
    if [ "$mode" = tv ]; then
      # No typing at all: one typed character turns the TV's on-screen keyboard off for the session. Start already signed in.
      pre "wait 2500"; until_screen home
    else
      pre "wait 2500"; pre "key down 10"; pre "key up"; pre "key backspace 60"; pre "type $server"; pre "key enter"; until_screen signin
      pre "type $user"; pre "key down"; pre "type $pass"; pre "key enter"; until_screen home
    fi
  fi
  printf '%s\n' '!ready' > "$d/in"                  # restart numbering; TV sessions lock to remote keys
  sleep 0.3; find "$d/shots" -name '*.jpg' -delete; : > "$d/out"; : > "$d/cmds"
  step "$name" wait 100
}

stop_quiet() {
  local d=$FLEET/$1
  [ -p "$d/in" ] && { timeout 3 bash -c 'printf "!quit\n" > "$1"' _ "$d/in" || true; }
  sleep 1; docker rm -f "rfd-$1" > /dev/null 2>&1 || true
}

case "${1:-}" in
  start) shift; start "$@";;
  stop) [ -n "${2:-}" ] && [ -d "$FLEET/$2" ] || die "rf-drive stop NAME"; stop_quiet "$2"; echo "stopped $2 (folder kept: $FLEET/$2)";;
  ""|-h|--help) sed -n 2,9p "$0";;
  *) [ $# -ge 2 ] || die "rf-drive NAME <command…>"; step "$@";;
esac
